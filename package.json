{
  "name": "proofrail-webmcp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .vinext --ignore-pattern .wrangler",
    "typecheck": "tsc --noEmit",
    "test:domain": "node --experimental-strip-types scripts/verify-domain.ts",
    "test:publication-brief": "node --experimental-strip-types scripts/verify-publication-brief.ts",
    "test:publication-import": "node --experimental-strip-types scripts/verify-publication-import.ts",
    "test:webmcp": "node --experimental-strip-types scripts/verify-webmcp-contract.ts",
    "qa:browsers": "node scripts/qa-browser-matrix.mjs",
    "qa:workflow": "node scripts/qa-browser-workflow.mjs",
    "qa:renderers": "node scripts/qa-renderer-captures.mjs",
    "qa:lighthouse": "node scripts/qa-lighthouse.mjs",
    "test:clarity": "node --experimental-strip-types scripts/verify-clarity.ts",
    "verify": "npm run typecheck && npm run test:domain && npm run test:publication-brief && npm run test:publication-import && npm run test:webmcp && npm run test:clarity && npm run lint && npm run build"
  },
  "dependencies": {
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^1.54.1",
    "@cloudflare/workers-types": "^5.20260827.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitejs/plugin-rsc": "^0.5.34",
    "chrome-launcher": "^1.2.1",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.3",
    "lighthouse": "^13.4.1",
    "playwright": "^1.62.1",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "^1.0.0-beta.8",
    "vite": "^8.2.2",
    "wrangler": "^4.127.0"
  },
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "0.35.0"
  },
  "type": "module"
}
